# Скопируйте этот файл в .env и вставьте свой ключ.
# .env в git не попадает (см. .gitignore) — секреты в репозиторий не коммитим.
# ВСЕ настройки проекта собраны здесь: правим только этот файл, код не трогаем.

# --- Режим работы ---
# voice = слушать микрофон, text = набирать вопросы с клавиатуры (для отладки)
INPUT_MODE=voice
# 1 = прогонять самопроверку при каждом запуске
STARTUP_CHECK=0

# --- Мозг: DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Потолок длины ответа: защита от «простыни», которую невозможно слушать
DEEPSEEK_MAX_TOKENS=500

# --- Уши: как распознавать речь ---
# google  = бесплатно, нужен интернет, хорошее качество для русского
# vosk    = офлайн, нужен пакет vosk и скачанная модель (см. README)
# whisper = офлайн, точнее всех, но тяжелее (пакет faster-whisper)
STT_BACKEND=google
STT_LANGUAGE=ru-RU

# --- Уши: когда считать, что человек закончил говорить (VAD) ---
# Самая капризная часть голосового бота: поспешишь — оборвёшь на полуслове,
# промедлишь — человек заскучает. Если бот стал слишком задумчивым,
# уменьшайте VAD_SILENCE_SECONDS и VAD_SILENCE_AFTER_SHORT.
# Сколько секунд ждать начала речи
VAD_START_TIMEOUT=15
# Пауза, после которой фраза считается законченной
VAD_SILENCE_SECONDS=1.3
# Речь короче этих секунд считаем недослушанной и ждём дольше
VAD_SHORT_SPEECH_SECONDS=1.2
# ...а именно столько ждём в этом случае
VAD_SILENCE_AFTER_SHORT=2.0
# Запас после последнего громкого блока: конец слова затихает, его нельзя резать
VAD_TAIL_SECONDS=0.5
# Минимальный порог громкости (шкала int16). Шумный микрофон — поднимайте
VAD_MIN_THRESHOLD=120

# --- Рот: как говорить ---
# auto = сначала edge-tts (живой голос, нужен интернет), при сбое SAPI (офлайн, робот)
# edge = только edge-tts
# sapi = только системный голос Windows
TTS_BACKEND=auto
TTS_VOICE=ru-RU-SvetlanaNeural
# Темп речи: -10% медленнее, +10% быстрее
TTS_RATE=+0%
# Сколько фраз синтезировать на опережение. 1 = синтез идёт строго за речью,
# и между предложениями слышна пауза на сетевой запрос. 3 и больше = следующая
# фраза готова, пока звучит текущая, поэтому стыки незаметны. Это главная
# настройка, если бот делает паузы посреди ответа.
TTS_PREFETCH=3
# Минимальная длина первой реплики: она должна начать звучать как можно раньше
TTS_MIN_CHARS_FIRST=16
# Минимальная длина следующих реплик. Короткие предложения склеиваются в одну
# реплику: каждый вызов синтеза — это стык и сброс интонации, поэтому крупные
# куски и звучат естественнее, и синтезируются быстрее
TTS_MIN_CHARS=45

# --- Инструменты: доступ в интернет ---
# 0 = бот отвечает только по своим знаниям, без поиска
ENABLE_TOOLS=1
# Сколько раундов поиска разрешено, прежде чем бот обязан ответить
TOOL_MAX_ROUNDS=2
# Сколько секунд максимум ждать поиск. В разговоре человек не будет ждать минуту:
# когда время вышло, бот отвечает тем, что уже успел найти
TOOL_BUDGET_SECONDS=25
SEARCH_MAX_RESULTS=4
# Сколько символов фрагмента возвращать из поиска
SEARCH_SNIPPET_CHARS=300
SEARCH_REGION=ru-ru
# Сколько текста страницы отдавать модели. Значение важнее, чем кажется:
# каждая следующая реплика модели заново «прожёвывает» весь этот текст,
# поэтому большой лимит напрямую увеличивает паузу в разговоре.
FETCH_MAX_CHARS=2500
HTTP_TIMEOUT=15
# Максимум байт, которые вообще качаем со страницы
HTTP_MAX_BYTES=600000
# Что сказать вслух, если модель сама не предупредила о поиске
TOOL_FILLER=Секунду, уточню это в интернете.

# --- Микрофон/динамики: оставьте пустым для устройств по умолчанию ---
# Посмотреть номера устройств: python check.py
INPUT_DEVICE=
OUTPUT_DEVICE=
